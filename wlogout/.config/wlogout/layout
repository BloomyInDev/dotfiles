{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown -t 'Rebooting...' --post-cmd 'systemctl reboot'",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "sleep",
    "action" : "systemctl suspend",
    "text" : "Sleep",
    "keybind" : "u"
}
{
    "label" : "windows",
    "action" : "hyprshutdown -t 'Rebooting to Windows...' --post-cmd 'systemctl reboot --boot-loader-entry=auto-windows'",
    "text" : "Windows",
    "keybind" : "w"
}
{
    "label" : "logout",
    "action" : "hyprshutdown -t 'Logging out...'",
    "text" : "Exit",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown -t 'Shutting down...' --post-cmd 'systemctl poweroff'",
    "text" : "Shutdown",
    "keybind" : "s"
}
